# ---------------------------------------------------------------------------
# OUVATU — environment variables
# Copy to .env.local and fill in. Never commit real values.
# With NO variables set, OUVATU runs in "local mode": JSON file database,
# local email/password auth, heuristic analyzer and simulated billing.
# ---------------------------------------------------------------------------

# Public URL of the app (used for Stripe & auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (database + auth) -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for analytics, Stripe webhook, admin and account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (payments) -----------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs of the recurring prices (displayed amounts live in src/config/plans.ts)
STRIPE_PRICE_PREMIUM_WEEKLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# --- AI provider -----------------------------------------------------------
# "anthropic" (default when AI_API_KEY is set) or "heuristic" (no LLM)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5

# --- Maps ------------------------------------------------------------------
# "osm" (OpenStreetMap Nominatim, free, default), "google" (needs MAPS_API_KEY) or "none"
MAPS_PROVIDER=osm
MAPS_API_KEY=
# Contact email sent to Nominatim (required by its usage policy)
MAPS_CONTACT_EMAIL=
# Map tiles (client). Defaults to OpenStreetMap; use MapTiler/Stadia/Mapbox in production.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# --- Optional enrichment / sources ------------------------------------------
TMDB_API_KEY=
YOUTUBE_API_KEY=
# Meta app token to use the official Instagram oEmbed endpoint
META_OEMBED_TOKEN=

# --- App ---------------------------------------------------------------------
# Comma-separated emails allowed to open /admin
ADMIN_EMAILS=
# Signs local-mode session cookies (required if local mode runs in production)
SESSION_SECRET=
# Local mode database file (default: .data/ouvatu-local-db.json)
OUVATU_LOCAL_DB_PATH=
# Allow the simulated checkout in production when Stripe is not configured (demo only)
OUVATU_DEMO_BILLING=false
# "Voir des exemples" button: on in dev by default, set true to enable in production
OUVATU_ENABLE_EXAMPLES=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_ENTITY=
